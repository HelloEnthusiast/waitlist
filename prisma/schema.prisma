generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Persona {
  INDIVIDUAL
  LAWYER
  BUSINESS
  STUDENT
}

model WaitlistEntry {
  // Autoincrement id doubles as the signup sequence number used for queue position.
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  persona       Persona  @default(INDIVIDUAL)
  referralCode  String   @unique
  referredById  Int?
  referredBy    WaitlistEntry?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     WaitlistEntry[] @relation("Referrals")
  referralCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([referredById])
}
